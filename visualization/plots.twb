      <aliases enabled='yes' />
      <column caption='lagged' datatype='real' name='[Calculation_0178671122001922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([F1])-LOOKUP(AVG([F1]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='All F1 Benchmark' datatype='real' name='[Calculation_0178671137800199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [test_lang], [epoch] :&#13;&#10;    AVG(&#13;&#10;        IF [targ_lang] = &quot;all&quot; THEN [F1] END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='f1 vs all' datatype='real' name='[Calculation_0178671138099208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr([targ_lang]) = &quot;all&quot; then 0 ELSE AVG([F1]) - AVG([Calculation_1066255422988289]) END' />
      </column>
      <column caption='epoch3' datatype='real' name='[Calculation_1066255422988289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [test_lang] :&#13;&#10;    MAX(&#13;&#10;        IF [targ_lang] = &quot;all&quot;&#13;&#10;        AND INT([epoch]) = 3&#13;&#10;        THEN FLOAT([F1])&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='difference' datatype='real' name='[Calculation_1493687331885057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max([F1])-MIN([F1])' />
      </column>
